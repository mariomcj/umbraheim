# Texto com fim de linha normalizado; scripts e configs de servidor sempre em LF (Linux).
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.gd text eol=lf
*.json text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdshader text eol=lf
*.gdshaderinc text eol=lf

# Binários
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.glb binary
*.bin binary
*.hdr binary
*.exr binary
*.ttf binary
*.otf binary
*.woff2 binary
*.so binary
*.dll binary
*.res binary
