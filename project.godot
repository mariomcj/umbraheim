; Engine configuration file.
; Renderer Compatibility (WebGL 2) obrigatório: a build Web é a plataforma principal.

config_version=5

[application]

config/name="Umbraheim"
config/description="Umbraheim: MMORPG de fantasia sombria centrado em feitiçaria (protótipo)."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.03, 0.02, 0.05, 1)
boot_splash/image="res://client/ui/art/umbraheim_splash.png"

[autoload]

GameConfig="*res://shared/config/game_config.gd"
Net="*res://shared/net/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=1
